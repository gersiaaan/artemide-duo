<?xml version="1.0" encoding="utf-8"?>
<!-- Host page after a disconnect: settles in softly from 104 %. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in" android:duration="620">
    <scale android:fromXScale="1.04" android:toXScale="1.0" android:fromYScale="1.04" android:toYScale="1.0"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:interpolator="@android:interpolator/decelerate_quad" android:fromAlpha="0.0" android:toAlpha="1.0" />
</set>
