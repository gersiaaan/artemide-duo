<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the closing screen shrinks to 94 % and fades out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad" android:duration="280" android:zAdjustment="top">
    <scale android:fromXScale="1" android:toXScale="0.94" android:fromYScale="1" android:toYScale="0.94"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" />
</set>
