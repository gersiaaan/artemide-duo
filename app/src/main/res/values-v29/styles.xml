<resources>
    <style name="AppBaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Duo accent everywhere (no Material purple in menus, dialogs, ripples) -->
        <item name="colorPrimary">#FF00B8D4</item>
        <item name="colorSecondary">#FF00B8D4</item>
        <item name="colorAccent">#FF00B8D4</item>
        <item name="colorControlActivated">#FF00B8D4</item>
        <item name="android:colorAccent">#FF00B8D4</item>
        <item name="android:colorControlActivated">#FF00B8D4</item>
        <item name="android:colorPrimary">#FF00B8D4</item>
        <!-- Duo look for every dialog and loading spinner (see DuoAlertDialog) -->
        <item name="android:alertDialogTheme">@style/DuoAlertDialog</item>
        <item name="alertDialogTheme">@style/DuoAlertDialog.Compat</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Avoid some systems like MIUI which break the visibility of games title -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="SettingsTheme" parent="AppTheme">
        <item name="preferenceTheme">@style/DuoPreferenceTheme</item>
        <!-- Duo cyan instead of Material's purple for checkboxes, sliders, radio buttons -->
        <item name="colorPrimary">#FF00B8D4</item>
        <item name="colorSecondary">#FF00B8D4</item>
        <item name="colorAccent">#FF00B8D4</item>
        <item name="colorControlActivated">#FF00B8D4</item>
        <item name="android:colorAccent">#FF00B8D4</item>
        <item name="android:colorControlActivated">#FF00B8D4</item>
    </style>
</resources>